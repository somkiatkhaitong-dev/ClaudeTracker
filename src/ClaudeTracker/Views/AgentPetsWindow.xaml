<Window x:Class="ClaudeTracker.Views.AgentPetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:ClaudeTracker.Views.Controls"
        Title="Desktop Pets"
        Width="320" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
    <Grid x:Name="RootGrid" Background="Transparent">
        <ItemsControl x:Name="PetsHost" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="PetCanvas"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:AgentPetControl/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Bottom" Value="0"/>
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Border x:Name="GroundStrip" Height="14" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeAll"
                MouseLeftButtonDown="GroundStrip_MouseLeftButtonDown">
            <Border Height="1.5" VerticalAlignment="Top" CornerRadius="1"
                    Background="{DynamicResource BorderSubtle}" Margin="8,0"/>
        </Border>

        <Button x:Name="CloseButton" Width="20" Height="20" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                Style="{StaticResource MaterialDesignIconButton}" Opacity="0"
                ToolTip="Hide pets">
            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
        </Button>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity"
                                     To="0.8" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseButton" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
