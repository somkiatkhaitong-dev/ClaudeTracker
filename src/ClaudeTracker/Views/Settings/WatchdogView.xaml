<UserControl x:Class="ClaudeTracker.Views.Settings.WatchdogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utilities="clr-namespace:ClaudeTracker.Utilities">
    <UserControl.Resources>
        <utilities:PendingResumeExclusionConverter x:Key="PendingResumeExclusionConverter" />
        <utilities:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
        <StackPanel MaxWidth="480">
            <TextBlock Text="Watchdog" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
            <TextBlock Text="Queue sessions observed when the usage limit is reached, then resume them after quota resets. Review the pending list before enabling automatic behavior."
                       FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                       TextWrapping="Wrap" Margin="0,0,0,20" />

            <!-- Enable -->
            <Grid Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="Resume Session on Reset" FontSize="13" />
                    <TextBlock Text="When your usage limit resets, reopen queued projects and continue with a prompt. Multiple active sessions may be queued together."
                               FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ToggleButton x:Name="ResumeEnabledToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Style="{StaticResource CompactSwitch}" />
            </Grid>

            <!-- Mode -->
            <StackPanel x:Name="ModePanel" Margin="0,0,0,20">
                <TextBlock Text="MODE" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                <Border Background="#15F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <TextBlock Text="Unattended mode is conservative: only sessions captured with bypassPermissions are resumed automatically. Other permission modes remain pending and require your approval."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                </Border>

                <RadioButton x:Name="InteractiveModeRadio" GroupName="WatchdogMode" Margin="0,4,0,10">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Interactive" FontSize="13" />
                        <TextBlock Text="Opens a visible terminal with the continuation prompt already sent. Stays open on failure so you can see what happened."
                                   FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="UnattendedModeRadio" GroupName="WatchdogMode" Margin="0,4,0,4">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Unattended" FontSize="13" />
                        <TextBlock Text="Resumes headlessly, no visible window, with automatic retry. Only resumes sessions already running in Bypass-Permissions mode — it never grants broader access on its own; anything else is skipped and left for you to resume manually."
                                   FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Allowed Projects -->
            <TextBlock Text="ALLOWED PROJECTS" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
            <TextBlock Text="Leave empty to allow every project. Paths are normalized as Windows directories; a path also includes its subdirectories, but not similarly-prefixed siblings."
                       FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="AllowedProjectInput" Grid.Column="0" IsEditable="True"
                          Style="{StaticResource MaterialDesignComboBox}" FontSize="12" Margin="0,0,8,0" />
                <Button x:Name="AddAllowedProjectButton" Grid.Column="1" Content="Add"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" FontSize="12" />
            </Grid>
            <ItemsControl x:Name="AllowedProjectsList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                       ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Remove" FontSize="11"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding DataContext.RemoveAllowedProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pending -->
            <TextBlock Text="PENDING" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
            <TextBlock Text="The list may contain more than one session because usage is account-wide. Check project, permission mode, and status before enabling Auto-resume. You can also queue one manually below."
                       FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ActiveSessionCombo" Grid.Column="0"
                          Style="{StaticResource MaterialDesignComboBox}" FontSize="12" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProjectName, Mode=OneWay}" ToolTip="{Binding SessionId, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="AddPendingResumeButton" Grid.Column="1" Content="Add"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" FontSize="12" />
            </Grid>
            <TextBlock x:Name="NoActiveSessionsText" Text="No active sessions detected right now — start a claude session to make it selectable here."
                       FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="NoPendingText" Text="Nothing waiting on a reset right now."
                       FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,12" />
            <ItemsControl x:Name="PendingList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0">
                                        <Run Text="Resets " /><Run Text="{Binding SessionResetAtUtc, Mode=OneWay, StringFormat={}{0:HH:mm} UTC}" />
                                        <Run Text=" · Attempts: " /><Run Text="{Binding AttemptCount, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding LastOutcome, Mode=OneWay}" />
                                        <Run Text=" · Permission: " /><Run Text="{Binding PermissionMode, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PendingResumeExclusionConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.AllowedProjects" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Text="{Binding ResetTimeInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Width="140" VerticalAlignment="Center"
                                                 ToolTip="Local time, e.g. 2026-07-17 18:00" />
                                        <Button Content="Set" FontSize="10" Margin="6,0,0,0"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.SetResumeTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResetTimeError}" FontSize="10" Foreground="#F44336"
                                               Visibility="{Binding ResetTimeError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <CheckBox Content="Auto-resume" FontSize="11" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleResumeEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                                    <Button Content="Remove" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding DataContext.RemovePendingResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- History -->
            <TextBlock Text="HISTORY" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
            <TextBlock x:Name="NoHistoryText" Text="No Watchdog activity yet."
                       FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,12" />
            <ItemsControl x:Name="HistoryList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="0,8">
                            <StackPanel>
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding TimestampUtc, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}" FontWeight="Medium" />
                                    <Run Text=" — " /><Run Text="{Binding Kind, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding ProjectName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" FontSize="11"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}">
            <Button x:Name="SaveButton" Content="Save Changes"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left" Height="34" FontSize="12"
                    Visibility="Collapsed" />
        </Border>
    </Grid>
</UserControl>
