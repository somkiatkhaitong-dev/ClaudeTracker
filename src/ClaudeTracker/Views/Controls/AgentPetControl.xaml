<UserControl x:Class="ClaudeTracker.Views.Controls.AgentPetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="90" Height="78" IsHitTestVisible="True">
    <Grid x:Name="FlipRoot" RenderTransformOrigin="0.5,1" Background="Transparent">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Flip" ScaleX="1"/>
        </Grid.RenderTransform>
        <Grid.ToolTip>
            <ToolTip Content="{Binding TooltipText}"/>
        </Grid.ToolTip>
        <Canvas>
            <TextBlock x:Name="ZzzText" Canvas.Left="52" Canvas.Top="2" Text="z z"
                       FontSize="10" FontStyle="Italic" Opacity="0"
                       Foreground="{DynamicResource TextMuted}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ZzzDrift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <materialDesign:PackIcon xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                                     x:Name="Sparkle" Kind="Creation" Width="12" Height="12"
                                     Canvas.Left="4" Canvas.Top="8" Foreground="#E8C15A"
                                     Visibility="Collapsed"/>

            <Ellipse x:Name="Halo" Canvas.Left="17" Canvas.Top="0" Width="38" Height="11"
                     Stroke="#E8C15A" StrokeThickness="2.5" Fill="Transparent" Opacity="0"/>

            <Path x:Name="WingLeft" Canvas.Left="0" Canvas.Top="20"
                  Data="M18,10 Q-10,-6 -8,26 Q-2,42 18,30 Z"
                  Fill="#F6EFDD" Stroke="#D8B65C" StrokeThickness="1.5"
                  RenderTransformOrigin="0.85,0.35">
                <Path.RenderTransform><RotateTransform x:Name="WingLeftRotate" Angle="15"/></Path.RenderTransform>
            </Path>
            <Path x:Name="WingRight" Canvas.Left="66" Canvas.Top="20"
                  Data="M6,10 Q34,-6 32,26 Q26,42 6,30 Z"
                  Fill="#F6EFDD" Stroke="#D8B65C" StrokeThickness="1.5"
                  RenderTransformOrigin="0.15,0.35">
                <Path.RenderTransform><RotateTransform x:Name="WingRightRotate" Angle="-15"/></Path.RenderTransform>
            </Path>

            <Grid x:Name="Body" Canvas.Left="8" Canvas.Top="14" Width="74" Height="64"
                  RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Bob"/>
                </Grid.RenderTransform>

                <Ellipse Width="74" Height="64" Fill="#FBF6EA" Stroke="#D8B65C" StrokeThickness="2"/>
                <Ellipse Width="40" Height="20" Fill="#F0DFA8" Opacity="0.55"
                         VerticalAlignment="Bottom" Margin="0,0,0,6"/>

                <StackPanel x:Name="EyesOpen" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,20,0,0">
                    <Grid Width="8" Height="11" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BlinkL"/></Grid.RenderTransform>
                        <Ellipse Fill="#3A3226"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Top" Margin="1.5,2,0,0"/>
                    </Grid>
                    <Grid Width="8" Height="11" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BlinkR"/></Grid.RenderTransform>
                        <Ellipse Fill="#3A3226"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Top" Margin="1.5,2,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="EyesClosed" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,25,0,0" Visibility="Collapsed">
                    <Path Data="M0,2 Q5,6 10,2" Stroke="#3A3226" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                    <Path Data="M0,2 Q5,6 10,2" Stroke="#3A3226" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </StackPanel>

                <Ellipse Width="9" Height="9" Fill="#4FB8AE" Opacity="0.55"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,33,0,0"/>
                <Ellipse Width="9" Height="9" Fill="#4FB8AE" Opacity="0.55"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,33,6,0"/>

                <Path x:Name="Smile" Data="M0,0 Q7,5 14,0" Stroke="#3A3226" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0"/>
            </Grid>

            <Ellipse x:Name="FootL" Canvas.Left="20" Canvas.Top="60" Width="12" Height="7" Fill="#E8C15A">
                <Ellipse.RenderTransform><TranslateTransform x:Name="FootLT"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="FootR" Canvas.Left="56" Canvas.Top="60" Width="12" Height="7" Fill="#E8C15A">
                <Ellipse.RenderTransform><TranslateTransform x:Name="FootRT"/></Ellipse.RenderTransform>
            </Ellipse>

            <Grid x:Name="BabyBlob" Canvas.Left="66" Canvas.Top="42" Width="26" Height="26"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform><TranslateTransform x:Name="BabyBob"/></Grid.RenderTransform>
                <Ellipse Width="24" Height="20" Fill="#FBF6EA" Stroke="#D8B65C" StrokeThickness="1"
                         VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Ellipse Width="3.2" Height="4.5" Fill="#3A3226" Margin="0,0,4,0"/>
                    <Ellipse Width="3.2" Height="4.5" Fill="#3A3226"/>
                </StackPanel>
                <Ellipse Width="6" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,3" Fill="#E8C15A"/>
                <Ellipse Width="6" Height="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,3" Fill="#E8C15A"/>
            </Grid>

            <Border x:Name="SubagentBadge" Canvas.Left="4" Canvas.Top="26" MinWidth="15" Height="15"
                    CornerRadius="7.5" Background="#4FB8AE" Visibility="Collapsed">
                <TextBlock Text="{Binding SubagentCount}" FontSize="9" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
