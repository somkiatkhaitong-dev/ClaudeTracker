<UserControl x:Class="ClaudeTracker.Views.Controls.AgentPetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utilities="clr-namespace:ClaudeTracker.Utilities"
             Width="84" Height="66" IsHitTestVisible="True">
    <UserControl.Resources>
        <utilities:TokenToBrushConverter x:Key="TokenBrush"/>
    </UserControl.Resources>
    <Grid x:Name="FlipRoot" RenderTransformOrigin="0.5,1" Background="Transparent">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Flip" ScaleX="1"/>
        </Grid.RenderTransform>
        <Grid.ToolTip>
            <ToolTip Content="{Binding TooltipText}"/>
        </Grid.ToolTip>
        <Canvas>
            <TextBlock x:Name="ZzzText" Canvas.Left="46" Canvas.Top="2" Text="z z"
                       FontSize="10" FontStyle="Italic" Opacity="0"
                       Foreground="{DynamicResource TextMuted}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ZzzDrift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <materialDesign:PackIcon x:Name="Sparkle" Kind="Creation" Width="11" Height="11"
                                     Canvas.Left="0" Canvas.Top="6" Foreground="#F0B429"
                                     Visibility="Collapsed"/>

            <materialDesign:PackIcon x:Name="Gear" Kind="Cog" Width="13" Height="13"
                                     Canvas.Left="45" Canvas.Top="4"
                                     Foreground="{DynamicResource TextMuted}"
                                     Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform x:Name="GearSpin"/>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>

            <Grid x:Name="Body" Canvas.Left="6" Canvas.Top="14" Width="44" Height="40"
                  RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="BodyTilt" Angle="0"/>
                        <TranslateTransform x:Name="Bob"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Border CornerRadius="22,22,15,15"
                        Background="{Binding ColorToken, Converter={StaticResource TokenBrush}}"
                        BorderBrush="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}"
                        BorderThickness="1.5"/>
                <Border Width="26" Height="13" CornerRadius="10" Background="White" Opacity="0.35"
                        VerticalAlignment="Bottom" Margin="0,0,0,3"/>

                <StackPanel x:Name="EyesOpen" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,9,0,0">
                    <Grid Width="6" Height="9" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BlinkL"/></Grid.RenderTransform>
                        <Ellipse Fill="#2E2E3E"/>
                        <Ellipse Width="2" Height="2" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Top" Margin="1,2,0,0"/>
                    </Grid>
                    <Grid Width="6" Height="9" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BlinkR"/></Grid.RenderTransform>
                        <Ellipse Fill="#2E2E3E"/>
                        <Ellipse Width="2" Height="2" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Top" Margin="1,2,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="EyesClosed" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,13,0,0" Visibility="Collapsed">
                    <Path Data="M0,2 Q4,5 8,2" Stroke="#2E2E3E" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0"/>
                    <Path Data="M0,2 Q4,5 8,2" Stroke="#2E2E3E" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </StackPanel>

                <Ellipse Width="7" Height="7" Fill="#F6A5B8" Opacity="0.8"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,20,0,0"/>
                <Ellipse Width="7" Height="7" Fill="#F6A5B8" Opacity="0.8"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,3,0"/>

                <Path x:Name="Smile" Data="M0,0 Q6,4 12,0" Stroke="#2E2E3E" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0"/>
            </Grid>

            <Ellipse x:Name="FootL" Canvas.Left="12" Canvas.Top="54" Width="11" Height="6"
                     Fill="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="FootLT"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="FootR" Canvas.Left="33" Canvas.Top="54" Width="11" Height="6"
                     Fill="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="FootRT"/></Ellipse.RenderTransform>
            </Ellipse>

            <Grid x:Name="BabyBlob" Canvas.Left="58" Canvas.Top="36" Width="24" Height="24"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform><TranslateTransform x:Name="BabyBob"/></Grid.RenderTransform>
                <Border Width="22" Height="18" CornerRadius="11,11,8,8" VerticalAlignment="Top"
                        Background="{Binding ColorToken, Converter={StaticResource TokenBrush}}"
                        BorderBrush="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}"
                        BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                    <Ellipse Width="3" Height="4.5" Fill="#2E2E3E" Margin="0,0,4,0"/>
                    <Ellipse Width="3" Height="4.5" Fill="#2E2E3E"/>
                </StackPanel>
                <Ellipse Width="6" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,3"
                         Fill="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}"/>
                <Ellipse Width="6" Height="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,3"
                         Fill="{Binding ColorToken, Converter={StaticResource TokenBrush}, ConverterParameter=dark}"/>
            </Grid>

            <Border x:Name="SubagentBadge" Canvas.Left="0" Canvas.Top="20" MinWidth="15" Height="15"
                    CornerRadius="7.5" Background="#D4537E" Visibility="Collapsed">
                <TextBlock Text="{Binding SubagentCount}" FontSize="9" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
