<UserControl x:Class="ClaudeTracker.Views.Controls.AgentPetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="96" Height="97" IsHitTestVisible="True"
             RenderOptions.BitmapScalingMode="HighQuality">
    <Grid x:Name="FlipRoot" RenderTransformOrigin="0.5,1" Background="Transparent">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Flip" ScaleX="1"/>
        </Grid.RenderTransform>
        <Grid.ToolTip>
            <ToolTip Content="{Binding TooltipText}"/>
        </Grid.ToolTip>
        <Canvas>
            <TextBlock x:Name="ZzzText" Canvas.Left="72" Canvas.Top="0" Text="z z"
                       FontSize="11" FontStyle="Italic" Opacity="0"
                       Foreground="{DynamicResource TextMuted}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ZzzDrift"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid x:Name="Body" Canvas.Left="0" Canvas.Top="14" Width="96" Height="83"
                  RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Breathe" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="Bob"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- No BitmapCache here: it forced a two-stage downscale (art→cache at
                     RenderAtScale, then a bilinear cache→screen composite) that dropped the
                     crown's thin rods. A direct HighQuality downscale of the source (set on
                     the UserControl) renders every frame's rods cleanly. -->
                <Image x:Name="PetImage" Width="96" Height="83" Stretch="Uniform"/>

                <Canvas x:Name="EyesClosed" Visibility="Collapsed">
                    <Path x:Name="EyeClosedLeft"
                          Data="M0,3 Q5,7 10,3" Stroke="#3A3226" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="EyeClosedRight"
                          Data="M0,3 Q5,7 10,3" Stroke="#3A3226" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Grid>

            <Grid x:Name="BabyBlob" Canvas.Left="66" Canvas.Top="60" Width="32" Height="28"
                  Visibility="Collapsed" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform><TranslateTransform x:Name="BabyBob"/></Grid.RenderTransform>
                <Image x:Name="BabyImage" Stretch="Uniform"/>
            </Grid>

            <Border x:Name="SubagentBadge" Canvas.Left="0" Canvas.Top="40" MinWidth="16" Height="16"
                    CornerRadius="8" Background="#4FB8AE" Visibility="Collapsed">
                <TextBlock Text="{Binding SubagentCount}" FontSize="9" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
